---
// ================================================================
// Search — Pagefind 搜索框组件
// 提供搜索输入框和结果展示区域
// 需配合 astro-pagefind 插件使用（构建时自动生成索引）
// ----------------------------------------------------------------
// 自定义搜索提示文案：修改 placeholder 属性即可
// 搜索结果样式在 global.css 中通过 .pagefind-ui 类名覆盖
// ================================================================
---

<div class="search-wrapper">
  <div class="search-input-group">
    <svg class="search-input-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/>
    </svg>
    <input
      type="text"
      id="pagefindSearchInput"
      class="search-input"
      placeholder="搜索文章、资源..."
      aria-label="搜索"
    />
  </div>
  <div id="searchResults" class="search-results"></div>
</div>

<!-- Pagefind 搜索结果 UI 容器 -->
<div id="pagefind-search"></div>

<style>
  .search-wrapper {
    max-width: 720px;
    margin: 0 auto;
    width: 100%;
  }
  .search-input-group {
    position: relative;
    display: flex;
    align-items: center;
  }
  .search-input-icon {
    position: absolute;
    left: 1rem;
    color: var(--text-muted);
    pointer-events: none;
  }
  .search-input {
    width: 100%;
    padding: 0.85rem 1rem 0.85rem 2.8rem;
    font-size: 1rem;
    border: 2px solid var(--border-color);
    border-radius: 10px;
    background: var(--bg-primary);
    color: var(--text-primary);
    outline: none;
    transition: border-color 0.2s;
  }
  .search-input:focus {
    border-color: var(--color-primary);
  }
  .search-results {
    margin-top: 1rem;
  }
</style>

<script>
  // ================================================================
  // Pagefind 搜索初始化脚本
  // 构建后 Pagefind 会在 /pagefind/ 目录生成搜索索引
  // 更多配置参见：https://pagefind.app/
  // ================================================================

  (async function () {
    const input = document.getElementById('pagefindSearchInput');
    const results = document.getElementById('searchResults');
    if (!input || !results) return;

    // 动态加载 Pagefind 索引（构建后生成）
    const pagefind = await import('pagefind');
    pagefind.init();

    /** 搜索结果去抖定时器 */
    let debounceTimer;

    input.addEventListener('input', async () => {
      clearTimeout(debounceTimer);
      const query = input.value.trim();
      if (!query) {
        results.innerHTML = '';
        return;
      }

      debounceTimer = setTimeout(async () => {
        results.innerHTML = '<div class="search-loading">搜索中...</div>';

        // 执行搜索
        const search = await pagefind.search(query);
        if (!search.results || search.results.length === 0) {
          results.innerHTML = '<div class="search-no-results">未找到相关结果</div>';
          return;
        }

        // 获取前 10 条结果详情
        const limit = 10;
        const data = await Promise.all(
          search.results.slice(0, limit).map((r) => r.data())
        );

        results.innerHTML = data
          .map(
            (item) => `
            <a href="${item.url}" class="search-result-item">
              <h4 class="search-result-title">${item.meta?.title || '无标题'}</h4>
              <p class="search-result-excerpt">${item.excerpt || ''}</p>
            </a>
          `
          )
          .join('');
      }, 300); // 300ms 去抖
    });
  })();
</script>
