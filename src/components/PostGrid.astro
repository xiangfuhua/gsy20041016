---
// ================================================================
// PostGrid — 文章/资源网格组件
// 接收数据数组，自动生成响应式网格卡片
// 使用方式：
//   <PostGrid posts={posts} type="blog" />
//   <PostGrid posts={resources} type="resource" />
// ================================================================
import type { CollectionEntry } from 'astro:content';

export interface Props {
  /** 文章或资源数据数组 */
  posts: CollectionEntry<'blog'>[] | CollectionEntry<'resources'>[];
  /** 类型：'blog' 或 'resource' */
  type?: 'blog' | 'resource';
  /** 是否显示分类标签 */
  showCategory?: boolean;
}

const { posts = [], type = 'blog', showCategory = true } = Astro.props;

// 分类名称映射表 — 将英文 key 转为中文显示
const CATEGORY_NAMES: Record<string, string> = {
  office: '办公教程',
  programming: '编程学习',
  software: '软件安装',
  computer: '电脑问题',
  resources: '资源下载',
};
---

{
  posts.length > 0 ? (
    <div class="post-grid">
      {posts.map((post) => {
        const { title, description, date, heroImage, category, premium, tags } = post.data;
        const slug = post.id.replace(/\/index$/, '').replace(/\.(md|mdx)$/, ''); // 去除可能存在的 /index 后缀和文件扩展名
        const href = type === 'blog' ? `/blog/${slug}` : `/resources/${slug}`;
        return (
          <a href={href} class="post-card" key={post.id}>
            <!-- 缩略图区 -->
            <div class="post-thumb">
              {heroImage ? (
                <img src={heroImage} alt={title} loading="lazy" />
              ) : (
                <div class="post-thumb-placeholder">
                  <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                    <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/>
                    <circle cx="8.5" cy="8.5" r="1.5"/>
                    <path d="m21 15-5-5L5 21"/>
                  </svg>
                </div>
              )}
              {premium && <span class="premium-badge">付费</span>}
            </div>
            <!-- 内容区 -->
            <div class="post-body">
              {showCategory && category && (
                <span class="post-category">{CATEGORY_NAMES[category] || category}</span>
              )}
              <h3 class="post-title">{title}</h3>
              <p class="post-desc">{description}</p>
              <div class="post-meta">
                <time datetime={date.toISOString()}>
                  {date.toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' })}
                </time>
                {type === 'resource' && post.data.downloadUrl && (
                  <span class="download-hint">可下载</span>
                )}
              </div>
            </div>
          </a>
        );
      })}
    </div>
  ) : (
    <div class="post-grid-empty">
      <p>暂无内容，敬请期待。</p>
    </div>
  )
}

<style>
  .post-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.2rem;
  }
  .post-card {
    display: flex;
    flex-direction: column;
    background: var(--bg-primary);
    border: 1px solid var(--border-color);
    border-radius: 10px;
    overflow: hidden;
    text-decoration: none;
    color: var(--text-primary);
    transition: all 0.25s ease;
  }
  .post-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 6px 20px rgba(30, 58, 138, 0.1);
    border-color: var(--color-primary);
  }
  .post-thumb {
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--color-primary-light);
    position: relative;
  }
  .post-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s;
  }
  .post-card:hover .post-thumb img {
    transform: scale(1.05);
  }
  .post-thumb-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-primary);
    opacity: 0.4;
  }
  .premium-badge {
    position: absolute;
    top: 0.5rem;
    right: 0.5rem;
    background: #f59e0b;
    color: #fff;
    font-size: 0.7rem;
    padding: 0.15rem 0.5rem;
    border-radius: 4px;
    font-weight: 600;
  }
  .post-body {
    padding: 0.8rem 1rem;
    flex: 1;
    display: flex;
    flex-direction: column;
  }
  .post-category {
    display: inline-block;
    font-size: 0.7rem;
    color: var(--color-primary);
    background: var(--color-primary-light);
    padding: 0.15rem 0.5rem;
    border-radius: 4px;
    margin-bottom: 0.4rem;
    align-self: flex-start;
  }
  .post-title {
    font-size: 0.95rem;
    font-weight: 600;
    margin: 0 0 0.3rem;
    line-height: 1.4;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .post-desc {
    font-size: 0.8rem;
    color: var(--text-muted);
    margin: 0 0 0.5rem;
    line-height: 1.5;
    flex: 1;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .post-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 0.75rem;
    color: var(--text-muted);
  }
  .download-hint {
    color: var(--color-primary);
    font-weight: 500;
  }
  .post-grid-empty {
    text-align: center;
    padding: 3rem 1rem;
    color: var(--text-muted);
  }

  /* 移动端适配：至少两列 */
  @media (max-width: 640px) {
    .post-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 0.8rem;
    }
    .post-body {
      padding: 0.6rem;
    }
    .post-title {
      font-size: 0.85rem;
    }
    .post-desc {
      font-size: 0.75rem;
    }
  }
  @media (max-width: 400px) {
    .post-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
