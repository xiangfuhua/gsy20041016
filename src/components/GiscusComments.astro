<div class="giscus-comments"></div>

<script>
  const repo = import.meta.env.PUBLIC_GISCUS_REPO;
  const repoId = import.meta.env.PUBLIC_GISCUS_REPO_ID;
  const category = import.meta.env.PUBLIC_GISCUS_CATEGORY;
  const categoryId = import.meta.env.PUBLIC_GISCUS_CATEGORY_ID;

  function loadGiscus(theme = 'light') {
    const container = document.querySelector('.giscus-comments');
    if (!container) return;
    
    const existingScript = document.querySelector('script[giscus-widget]');
    const existingIframe = container.querySelector('iframe');
    if (existingScript) existingScript.remove();
    if (existingIframe) existingIframe.remove();

    const script = document.createElement('script');
    script.setAttribute('giscus-widget', '');
    script.src = 'https://giscus.app/client.js';
    script.setAttribute('data-repo', repo);
    script.setAttribute('data-repo-id', repoId);
    script.setAttribute('data-category', category);
    script.setAttribute('data-category-id', categoryId);
    script.setAttribute('data-mapping', 'pathname');
    script.setAttribute('data-strict', '0');
    script.setAttribute('data-reactions-enabled', '1');
    script.setAttribute('data-emit-metadata', '0');
    script.setAttribute('data-input-position', 'bottom');
    script.setAttribute('data-theme', theme);
    script.setAttribute('data-lang', 'zh-CN');
    script.setAttribute('data-loading', 'lazy');
    script.setAttribute('crossorigin', 'anonymous');
    script.async = true;
    
    container.appendChild(script);
  }

  const currentTheme = document.documentElement.classList.contains('dark') ? 'dark' : 'light';
  loadGiscus(currentTheme);

  const observer = new MutationObserver((mutations) => {
    mutations.forEach((mutation) => {
      if (mutation.attributeName === 'class') {
        const newTheme = document.documentElement.classList.contains('dark') ? 'dark' : 'light';
        loadGiscus(newTheme);
      }
    });
  });
  observer.observe(document.documentElement, { attributes: true });
</script>