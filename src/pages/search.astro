---
// ================================================================
// 搜索结果页 — search.astro
// 集成 Pagefind 搜索栏和结果展示
// ----------------------------------------------------------------
// Pagefind 在构建时（astro build）自动生成索引
// 搜索功能完全在客户端运行，无需后端服务
// ================================================================
import BaseLayout from '@/layouts/BaseLayout.astro';
import Search from '@/components/Search.astro';
---
<BaseLayout title="搜索" currentPath="/search">
  <div class="search-page">
    <h1 class="page-title">搜索</h1>
    <p class="page-desc">搜索文章、资源和教程。</p>
    <Search />
  </div>
</BaseLayout>

<style>
  .search-page {
    max-width: 720px;
    margin: 0 auto;
  }
  .page-title {
    font-size: 1.4rem;
    font-weight: 700;
    color: var(--text-primary);
    margin: 0 0 0.3rem;
  }
  .page-desc {
    font-size: 0.9rem;
    color: var(--text-secondary);
    margin: 0 0 1.5rem;
  }
</style>
